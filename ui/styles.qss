/* SmartID - Application Stylesheet */

/* ─── Global ─────────────────────────────────────────────── */
QMainWindow, QWidget {
    background-color: #F0F2F5;
    color: #1A1F36;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 9pt;
}

/* ─── Sidebar Navigation ─────────────────────────────────── */
#Sidebar {
    background-color: #1A2340;
    min-width: 220px;
    max-width: 220px;
}

#AppTitle {
    color: #FFFFFF;
    font-size: 16pt;
    font-weight: bold;
    padding: 20px 16px 8px 16px;
    letter-spacing: 1px;
}

#AppSubtitle {
    color: #7B88A8;
    font-size: 8pt;
    padding: 0px 16px 20px 16px;
}

#NavButton {
    background-color: transparent;
    color: #A0ADCA;
    border: none;
    text-align: left;
    padding: 12px 16px;
    font-size: 10pt;
    border-radius: 0px;
}

#NavButton:hover {
    background-color: #253056;
    color: #FFFFFF;
}

#NavButton[active="true"] {
    background-color: #2E5BFF;
    color: #FFFFFF;
    font-weight: bold;
    border-left: 3px solid #5B8DFF;
}

#SidebarDivider {
    background-color: #2A3354;
    min-height: 1px;
    max-height: 1px;
    margin: 8px 16px;
}

/* ─── Content Area ───────────────────────────────────────── */
#ContentArea {
    background-color: #F0F2F5;
}

#PageTitle {
    font-size: 18pt;
    font-weight: bold;
    color: #1A1F36;
    margin-bottom: 4px;
}

#PageSubtitle {
    font-size: 9pt;
    color: #6B7280;
    margin-bottom: 16px;
}

/* ─── Cards / Panels ─────────────────────────────────────── */
#Card {
    background-color: #FFFFFF;
    border-radius: 8px;
    border: 1px solid #E5E7EB;
}

#CardHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
    border-radius: 8px 8px 0px 0px;
    padding: 12px 16px;
    font-size: 11pt;
    font-weight: bold;
    color: #1A1F36;
}

/* ─── Buttons ────────────────────────────────────────────── */
QPushButton {
    background-color: #2E5BFF;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 9pt;
    font-weight: 600;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #1A47E8;
}

QPushButton:pressed {
    background-color: #1036C8;
}

QPushButton:disabled {
    background-color: #D1D5DB;
    color: #9CA3AF;
}

QPushButton#SecondaryBtn {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
}

QPushButton#SecondaryBtn:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
}

QPushButton#DangerBtn {
    background-color: #EF4444;
    color: #FFFFFF;
}

QPushButton#DangerBtn:hover {
    background-color: #DC2626;
}

QPushButton#SuccessBtn {
    background-color: #10B981;
    color: #FFFFFF;
}

QPushButton#SuccessBtn:hover {
    background-color: #059669;
}

QPushButton#IconBtn {
    background-color: transparent;
    color: #6B7280;
    border: none;
    padding: 4px 8px;
    min-height: 24px;
}

QPushButton#IconBtn:hover {
    background-color: #F3F4F6;
    color: #374151;
    border-radius: 4px;
}

/* ─── Table ──────────────────────────────────────────────── */
QTableWidget {
    background-color: #FFFFFF;
    gridline-color: #F3F4F6;
    border: none;
    selection-background-color: #EEF2FF;
    selection-color: #1A1F36;
    alternate-background-color: #FAFAFA;
}

QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #F3F4F6;
}

QTableWidget::item:selected {
    background-color: #EEF2FF;
    color: #1A1F36;
}

QHeaderView::section {
    background-color: #F9FAFB;
    color: #6B7280;
    font-weight: 600;
    font-size: 8pt;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #E5E7EB;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ─── Form Inputs ────────────────────────────────────────── */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 9pt;
    color: #1A1F36;
    min-height: 30px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2E5BFF;
    outline: none;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    selection-background-color: #EEF2FF;
    padding: 4px;
}

/* ─── Labels ─────────────────────────────────────────────── */
QLabel#FieldLabel {
    color: #374151;
    font-weight: 600;
    font-size: 8.5pt;
}

QLabel#HintLabel {
    color: #9CA3AF;
    font-size: 8pt;
}

/* ─── Search Box ─────────────────────────────────────────── */
QLineEdit#SearchBox {
    padding-left: 30px;
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 20px;
    min-width: 240px;
}

/* ─── Status Bar ─────────────────────────────────────────── */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E5E7EB;
    color: #6B7280;
    font-size: 8pt;
}

/* ─── Tab Widget ─────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #E5E7EB;
    border-radius: 0px 8px 8px 8px;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: #F9FAFB;
    color: #6B7280;
    padding: 8px 20px;
    border: 1px solid #E5E7EB;
    border-bottom: none;
    border-radius: 6px 6px 0px 0px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1A1F36;
    font-weight: 600;
    border-top: 2px solid #2E5BFF;
}

QTabBar::tab:hover {
    background-color: #FFFFFF;
    color: #374151;
}

/* ─── Scroll Bars ────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #F9FAFB;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #D1D5DB;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ─── Progress Bar ───────────────────────────────────────── */
QProgressBar {
    border: none;
    background-color: #E5E7EB;
    border-radius: 4px;
    text-align: center;
    min-height: 12px;
    max-height: 12px;
}

QProgressBar::chunk {
    background-color: #2E5BFF;
    border-radius: 4px;
}

/* ─── Message Box ────────────────────────────────────────── */
QMessageBox {
    background-color: #FFFFFF;
}

/* ─── Tooltip ────────────────────────────────────────────── */
QToolTip {
    background-color: #1A2340;
    color: #FFFFFF;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 8pt;
}

/* ─── Group Box ──────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: 600;
    color: #374151;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #374151;
    font-size: 9pt;
}

/* ─── Splitter ───────────────────────────────────────────── */
QSplitter::handle {
    background-color: #E5E7EB;
}

/* ─── Check Box ──────────────────────────────────────────── */
QCheckBox {
    spacing: 8px;
    color: #374151;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #D1D5DB;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #2E5BFF;
    border-color: #2E5BFF;
}
